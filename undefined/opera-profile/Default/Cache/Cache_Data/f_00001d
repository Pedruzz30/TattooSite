  <!--
    Precisa ser URL absoluta (não "/src/...") porque o Vite não reescreve
    caminhos dentro de meta[content] no build — e crawlers de redes sociais
    (WhatsApp, Instagram) não seguem redirect nem resolvem caminho relativo.
    A imagem em si vive em /public/og-image.jpg (1200x800, cai fora do
    pipeline de assets do src/ e é copiada como está para o build).
  -->
  <meta
    property="og:image"
    content="https://pedruzz30.github.io/TattooSite/og-image.jpg"
  />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
