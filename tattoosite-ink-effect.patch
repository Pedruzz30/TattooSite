+/*
+ * Canvas de fundo com manchas de tinta se movendo lentamente.
+ * Fica atrás de .hero-ink (a máscara de luz que reage ao mouse),
+ * dando profundidade sem precisar de vídeo — é só matemática,
+ * então não pesa nada no carregamento da página.
+ */
+.hero-ink-canvas {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  width: 100%;
+  height: 100%;
+  display: block;
+}
+
